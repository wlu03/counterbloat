# Copy to .env. Model identifiers are deployment settings; the code has no default model.
COUNTERCHECK_API_KEY=change-me
# Set to 1 to serve internal, uncalibrated research scores at /claims/{id}/research.
COUNTERCHECK_RESEARCH_VIEW=
DATABASE_URL=postgresql+psycopg://countercheck:countercheck@localhost:5432/countercheck
OBJECT_STORE_DIR=objects
# sec.gov requires the form "Name contact@your-domain". Without it SEC pages return 403.
FETCH_USER_AGENT=
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
OPENAI_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-5.6-luna
OPENAI_REASON_MODEL=gpt-5.6-sol
# Optional. Passed as reasoning.effort on every structured call. Lower values are faster.
OPENAI_REASONING_EFFORT=low
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMS=1536
TTC_API_KEY=
TYPESAFE_API_KEY=
