{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standardized ASA prediction",
  "type": "object",
  "required": [
    "example_id",
    "mode",
    "status"
  ],
  "properties": {
    "example_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "const": "asa"
    },
    "mode": {
      "enum": [
        "retrospective",
        "independent"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "pending",
        "abstained",
        "error"
      ]
    },
    "material_overstatement": {
      "enum": [
        "present",
        "absent",
        "undetermined",
        null
      ]
    },
    "evidence_status": {
      "enum": [
        "supported",
        "contradicted",
        "mixed",
        "insufficient",
        "not_yet_resolvable",
        null
      ]
    },
    "explanation": {
      "type": [
        "string",
        "null"
      ]
    },
    "supported_rewrite": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "probabilities": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "present",
            "absent",
            "undetermined"
          ],
          "properties": {
            "present": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "absent": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "undetermined": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "material_overstatement",
          "evidence_status"
        ],
        "properties": {
          "material_overstatement": {
            "enum": [
              "present",
              "absent",
              "undetermined"
            ]
          },
          "evidence_status": {
            "enum": [
              "supported",
              "contradicted",
              "mixed",
              "insufficient",
              "not_yet_resolvable"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$comment": "Runtime scorer additionally checks finite values, sums, argmax, mode, and known IDs."
}
